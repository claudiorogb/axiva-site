{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/crm",
      "destination": "/crm/index.html"
    },
    {
      "source": "/crm/contato",
      "destination": "/crm/contato/index.html"
    },
    {
      "source": "/crm/o-que-e-crm",
      "destination": "/crm/o-que-e-crm/index.html"
    },
    {
      "source": "/invest",
      "destination": "/invest/index.html"
    },
    {
      "source": "/crm/funil-de-vendas",
      "destination": "/crm/funil-de-vendas/index.html"
    },
    {
      "source": "/crm/prospeccao-b2b",
      "destination": "/crm/prospeccao-b2b/index.html"
    },
    {
      "source": "/crm/follow-up-comercial",
      "destination": "/crm/follow-up-comercial/index.html"
    },
    {
      "source": "/crm/como-organizar-leads",
      "destination": "/crm/como-organizar-leads/index.html"
    }
  ],
  "headers": [
    {
      "source": "/crm-funil-real.svg",
      "headers": [
        {
